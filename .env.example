# Search requires no API key. Query embeddings run on your CPU.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# The default pinned MiniLM model uses the standard Hugging Face cache.
# Set MODEL_PATH only for a local copy of that same verified snapshot.
# MODEL_PATH=/absolute/path/to/model/snapshot

# Change both the namespace and algorithm to keep independent experiments.
NAMESPACE=camera
INDEX_ALGORITHM=FLAT

# Required for chat; search works without the cloud services below.
# Get them with docs/guides/agent-memory-quickstart.md, then restart the backend.
# Use the memory-service HTTPS endpoint, Store ID and service key from Redis Cloud.
AGENT_MEMORY_BASE_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=
# This OpenAI API key is for the shop's replies.
OPENAI_API_KEY=
SHOP_CHAT_MODEL=gpt-5-mini

# Choose a fresh label for your demo shoppers (letters, digits and hyphens).
SHOP_OWNER_PREFIX=sams-camera-shop-v1
# Optional: an existing RAM namespace ID. Leave commented out for the quickstart.
# AGENT_MEMORY_NAMESPACE_ID=

# Optional Playbook guidance. Leave all three empty for the quickstart.
# When using Playbook, configure all three together.
# The local setup script writes these to .env without printing the read key.
SHOP_PLAYBOOK_URL=
SHOP_PLAYBOOK_ID=
SHOP_PLAYBOOK_API_KEY=

# Required for chat purchase and delivery retrieval. See docs/guides/context-retriever-smoke.md.
# Copy the service's HTTPS MCP endpoint and two distinct shopper-scoped agent keys.
CTX_MCP_URL=
CTX_ALEX_AGENT_KEY=
CTX_JORDAN_AGENT_KEY=
# Setup/seeding only: these are never used by the running adviser or read-only check.
# Use the database connected to your Context Retriever service.
# CTX_REDIS_URL=rediss://default:password@host:port
CTX_ADMIN_KEY=
CTX_SURFACE_ID=
