# No API key is required. Query embeddings run on your CPU.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# The default pinned MiniLM model uses the standard Hugging Face cache.
# Set MODEL_PATH only for a local copy of that same verified snapshot.
# MODEL_PATH=/absolute/path/to/model/snapshot

# Change both the namespace and algorithm to keep independent experiments.
NAMESPACE=camera
INDEX_ALGORITHM=FLAT
