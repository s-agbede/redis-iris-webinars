# Required: powers the agent and the embedding model
OPENAI_API_KEY=sk-...

# Redis. Defaults to the container started by docker compose.
REDIS_URL=redis://localhost:6379

# Only needed to regenerate product descriptions (scripts/generate_descriptions.py).
# The generated output is committed, so you do not need this to run the app.
ANTHROPIC_API_KEY=

# Host port for the Redis container (change if 6379 is taken)
REDIS_PORT=6379
